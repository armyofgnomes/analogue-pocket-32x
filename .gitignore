
# Local, copyrighted BIOS images (never commit)
/bios/

# Packaged SD-card output from tools/package.py
/build/

# Quartus-generated assignment defaults
/src/fpga/ap_core_assignment_defaults.qdf

__pycache__/

# Generated from bios/ at build time (copyrighted BIOS data, never commit)
/src/fpga/core/bios_mif/

# Build outputs: not committed. Hardware-verified builds are published as GitHub releases
# (tools/release.sh), which are also the rollback points (docs/hardware-testing.md).
/output/*
!/output/.gitkeep
# Regenerated with the build date/time on every build (apf/build_id_gen.tcl)
/src/fpga/apf/build_id.mif
