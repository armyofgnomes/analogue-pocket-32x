+// Fit experiment (no_genmix): plain registered sum at the same levels as jt12_fm_uprate,
+// without jt12_genmix's PSG/FM resampling.
+reg signed [15:0] SL_r, SR_r;
+wire signed [11:0] psg_mix = EN_GEN_PSG ? {psg_adjust[10], psg_adjust} : 12'sd0;
+always @(posedge MCLK) begin
+	SL_r <= (EN_GEN_FM ? fm_select_l : 16'sd0) + {psg_mix[11], psg_mix, 3'b0};
+	SR_r <= (EN_GEN_FM ? fm_select_r : 16'sd0) + {psg_mix[11], psg_mix, 3'b0};
+end
+assign SL = SL_r;
+assign SR = SR_r;
 
