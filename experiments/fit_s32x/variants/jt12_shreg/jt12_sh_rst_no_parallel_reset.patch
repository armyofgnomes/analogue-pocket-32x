+// `stages` cycles (the Z80/YM reset pulse from 68K code is far longer than 24 MCLKs).
 generate
 	for (i=0; i < width; i=i+1) begin: bit_shifter
-		always @(posedge clk) 
-			if( rst ) begin
-				bits[i] <= {stages{rstval}};
-			end else if(clk_en) begin
-				bits[i] <= {bits[i][stages-2:0], din[i]};
+		always @(posedge clk)
+			if( rst || clk_en ) begin
+				bits[i] <= {bits[i][stages-2:0], rst ? rstval : din[i]};
 			end
 		assign drop[i] = bits[i][stages-1];
 	end
