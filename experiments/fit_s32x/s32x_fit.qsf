set_instance_assignment -name VIRTUAL_PIN ON -to AUDIO_L
set_instance_assignment -name VIRTUAL_PIN ON -to AUDIO_R

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"