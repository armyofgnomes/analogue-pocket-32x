# REQ-ARCH-03 fit experiment. Built by run.sh; upstream sources live in build/upstream (gitignored).
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C8
set_global_assignment -name TOP_LEVEL_ENTITY s32x_fit_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# Optimization settings copied from S32X_MiSTer's S32X.qsf, so ALM counts are comparable.
set_global_assignment -name OPTIMIZE_POWER_DURING_FITTING OFF
set_global_assignment -name FINAL_PLACEMENT_OPTIMIZATION ALWAYS
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE ON
set_global_assignment -name QII_AUTO_PACKED_REGISTERS NORMAL
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name MUX_RESTRUCTURE ON
set_global_assignment -name REMOVE_REDUNDANT_LOGIC_CELLS ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC_FOR_AREA ON
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
set_global_assignment -name SYNTH_GATED_CLOCK_CONVERSION ON
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING ON
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT LOW
set_global_assignment -name PLACEMENT_EFFORT_MULTIPLIER 2.0
set_global_assignment -name SEED 1

# Upstream S32X_MiSTer system logic (paths from files.qip, minus sys/, SDRAM/DDR controllers,
# cofi and the emu top level)
set_global_assignment -name QIP_FILE ../../build/upstream/S32X_MiSTer/rtl/FX68K/fx68k.qip
set_global_assignment -name QIP_FILE ../../build/upstream/S32X_MiSTer/rtl/GEN/GEN.qip
set_global_assignment -name QIP_FILE ../../build/upstream/S32X_MiSTer/rtl/CART/cart.qip
set_global_assignment -name QIP_FILE ../../build/upstream/S32X_MiSTer/rtl/SH/SH7604/SH7604.qip
set_global_assignment -name VERILOG_FILE ../../build/upstream/S32X_MiSTer/rtl/SH_mem.v
set_global_assignment -name VERILOG_FILE ../../build/upstream/S32X_MiSTer/rtl/vdp_mem.v
set_global_assignment -name QIP_FILE ../../build/upstream/S32X_MiSTer/rtl/32X/32X.qip
set_global_assignment -name SYSTEMVERILOG_FILE ../../build/upstream/S32X_MiSTer/rtl/32X_mem.sv
set_global_assignment -name VHDL_FILE ../../build/upstream/S32X_MiSTer/rtl/bram.vhd
set_global_assignment -name VHDL_FILE ../../build/upstream/S32X_MiSTer/rtl/mlab.vhd
set_global_assignment -name VHDL_FILE ../../build/upstream/S32X_MiSTer/rtl/CEGen.vhd
set_global_assignment -name VHDL_FILE ../../build/upstream/S32X_MiSTer/rtl/snd_mix.vhd
set_global_assignment -name SYSTEMVERILOG_FILE ../../build/upstream/S32X_MiSTer/rtl/cheatcodes.sv
set_global_assignment -name SYSTEMVERILOG_FILE s32x_fit_top.sv
set_global_assignment -name SDC_FILE s32x_fit.sdc

# Every port except the clock is a virtual pin: memory buses count as logic, not I/O.
set_instance_assignment -name VIRTUAL_PIN ON -to reset
set_instance_assignment -name VIRTUAL_PIN ON -to rom_download
set_instance_assignment -name VIRTUAL_PIN ON -to PAL
set_instance_assignment -name VIRTUAL_PIN ON -to EXPORT
set_instance_assignment -name VIRTUAL_PIN ON -to J3BUT
set_instance_assignment -name VIRTUAL_PIN ON -to LPF_MODE
set_instance_assignment -name VIRTUAL_PIN ON -to EN_GEN_FM
set_instance_assignment -name VIRTUAL_PIN ON -to EN_GEN_PSG
set_instance_assignment -name VIRTUAL_PIN ON -to EN_32X_PWM
set_instance_assignment -name VIRTUAL_PIN ON -to EN_HIFI_PCM
set_instance_assignment -name VIRTUAL_PIN ON -to LADDER
set_instance_assignment -name VIRTUAL_PIN ON -to OBJ_LIMIT_HIGH
set_instance_assignment -name VIRTUAL_PIN ON -to FMBUSY_QUIRK
set_instance_assignment -name VIRTUAL_PIN ON -to BORDER
set_instance_assignment -name VIRTUAL_PIN ON -to rom_sz
set_instance_assignment -name VIRTUAL_PIN ON -to s32x_rom
set_instance_assignment -name VIRTUAL_PIN ON -to eeprom_map
set_instance_assignment -name VIRTUAL_PIN ON -to noram_quirk
set_instance_assignment -name VIRTUAL_PIN ON -to realtec_map
set_instance_assignment -name VIRTUAL_PIN ON -to sf_map
set_instance_assignment -name VIRTUAL_PIN ON -to joy_1
set_instance_assignment -name VIRTUAL_PIN ON -to joy_2
set_instance_assignment -name VIRTUAL_PIN ON -to CART_ROM_A
set_instance_assignment -name VIRTUAL_PIN ON -to CART_ROM_DI
set_instance_assignment -name VIRTUAL_PIN ON -to CART_ROM_DO
set_instance_assignment -name VIRTUAL_PIN ON -to CART_ROM_RD
set_instance_assignment -name VIRTUAL_PIN ON -to CART_ROM_WRL
set_instance_assignment -name VIRTUAL_PIN ON -to CART_ROM_WRH
set_instance_assignment -name VIRTUAL_PIN ON -to CART_SRAM_A
set_instance_assignment -name VIRTUAL_PIN ON -to CART_SRAM_DI
set_instance_assignment -name VIRTUAL_PIN ON -to CART_SRAM_DO
set_instance_assignment -name VIRTUAL_PIN ON -to CART_SRAM_RD
set_instance_assignment -name VIRTUAL_PIN ON -to CART_SRAM_WR
set_instance_assignment -name VIRTUAL_PIN ON -to rom_busy
set_instance_assignment -name VIRTUAL_PIN ON -to sram_busy
set_instance_assignment -name VIRTUAL_PIN ON -to S32X_SDR_A
set_instance_assignment -name VIRTUAL_PIN ON -to S32X_SDR_DI
set_instance_assignment -name VIRTUAL_PIN ON -to S32X_SDR_DO
set_instance_assignment -name VIRTUAL_PIN ON -to S32X_SDR_CS
set_instance_assignment -name VIRTUAL_PIN ON -to S32X_SDR_WE
set_instance_assignment -name VIRTUAL_PIN ON -to S32X_SDR_RD
set_instance_assignment -name VIRTUAL_PIN ON -to S32X_SDR_WAIT
set_instance_assignment -name VIRTUAL_PIN ON -to FB0_A
set_instance_assignment -name VIRTUAL_PIN ON -to FB0_DI
set_instance_assignment -name VIRTUAL_PIN ON -to FB0_DO
set_instance_assignment -name VIRTUAL_PIN ON -to FB0_WE
set_instance_assignment -name VIRTUAL_PIN ON -to FB0_RD
set_instance_assignment -name VIRTUAL_PIN ON -to FB1_A
set_instance_assignment -name VIRTUAL_PIN ON -to FB1_DI
set_instance_assignment -name VIRTUAL_PIN ON -to FB1_DO
set_instance_assignment -name VIRTUAL_PIN ON -to FB1_WE
set_instance_assignment -name VIRTUAL_PIN ON -to FB1_RD
set_instance_assignment -name VIRTUAL_PIN ON -to GEN_R
set_instance_assignment -name VIRTUAL_PIN ON -to GEN_G
set_instance_assignment -name VIRTUAL_PIN ON -to GEN_B
set_instance_assignment -name VIRTUAL_PIN ON -to GEN_DOT_CE
set_instance_assignment -name VIRTUAL_PIN ON -to GEN_HBLANK
set_instance_assignment -name VIRTUAL_PIN ON -to GEN_VBLANK
set_instance_assignment -name VIRTUAL_PIN ON -to GEN_HS
set_instance_assignment -name VIRTUAL_PIN ON -to GEN_VS
set_instance_assignment -name VIRTUAL_PIN ON -to YS_N
set_instance_assignment -name VIRTUAL_PIN ON -to FIELD
set_instance_assignment -name VIRTUAL_PIN ON -to INTERLACE
set_instance_assignment -name VIRTUAL_PIN ON -to RESOLUTION
set_instance_assignment -name VIRTUAL_PIN ON -to S32X_R
set_instance_assignment -name VIRTUAL_PIN ON -to S32X_G
set_instance_assignment -name VIRTUAL_PIN ON -to S32X_B
set_instance_assignment -name VIRTUAL_PIN ON -to S32X_DOT_CE
set_instance_assignment -name VIRTUAL_PIN ON -to S32X_YSO_N
